ENVIRONMENT=local
LOG_LEVEL=INFO

APP_PORT=8000
POSTGRES_EXTERNAL_PORT=5433
MINIO_API_EXTERNAL_PORT=9000
MINIO_CONSOLE_EXTERNAL_PORT=9001

# Leave empty to auto-pick Postgres when POSTGRES_HOST is set, otherwise SQLite.
DATABASE_URL=
# Use localhost for local dev; docker-compose overrides this to db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fastapi_blogicum
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SQLITE_DB_PATH=app.db

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

S3_ENABLED=false
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=blogicum-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/blogicum-media
S3_PRESIGNED_EXPIRES_SECONDS=3600

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=false
